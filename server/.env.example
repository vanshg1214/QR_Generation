# Port the server listens on
PORT=4000

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI).
# Prefer the "Connection pooling" URI for an always-on app server like this one.
DATABASE_URL=postgresql://postgres.xxxx:your-db-password@aws-0-xxxx.pooler.supabase.com:6543/postgres

# Public base URL this server is reachable at (used to build the QR redirect links).
# In production set this to your deployed URL, e.g. https://qr-tracker.onrender.com
PUBLIC_BASE_URL=http://localhost:4000

# Password required to log into the dashboard
ADMIN_PASSWORD=changeme

# TEMPORARY (testing only): skips the login screen entirely when true.
# Must be false (or removed) before real/production use.
DISABLE_AUTH=false

# Random long string used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# Salt used when hashing visitor IPs for light dedup/analytics (not reversible)
IP_HASH_SALT=change-this-too
